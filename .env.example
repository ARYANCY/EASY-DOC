# Legal Document Analysis System - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# LLM Provider: "claude" or "openai"
LLM_PROVIDER=claude

# Anthropic API Key (for Claude)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# OpenAI API Key (for GPT-4)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================================================
# Processing Configuration
# ============================================================================

# Maximum document size in bytes (default: 50MB)
MAX_DOCUMENT_SIZE=52428800

# Maximum text length to process
MAX_TEXT_LENGTH=1000000

# OCR Language (Tesseract)
OCR_LANGUAGE=eng

# ============================================================================
# Output Configuration
# ============================================================================

# Output directory for analysis results
OUTPUT_DIR=./output

# Export formats (comma-separated)
EXPORT_FORMATS=json,csv,html

# Default export format
DEFAULT_EXPORT_FORMAT=json

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/analysis.log

# ============================================================================
# Database Configuration (Optional)
# ============================================================================

# Database URL for storing analysis results
# SQLite: sqlite:///./legal_analyzer.db
# PostgreSQL: postgresql://user:password@localhost:5432/legal_db
DATABASE_URL=sqlite:///./legal_analyzer.db

# ============================================================================
# RAG (Retrieval-Augmented Generation) Configuration
# ============================================================================

# Number of top relevant documents to retrieve
RAG_TOP_K=3

# Minimum similarity threshold (0-1)
SIMILARITY_THRESHOLD=0.3

# ============================================================================
# Cache Configuration
# ============================================================================

# Enable caching
ENABLE_CACHE=true

# Cache directory
CACHE_DIR=./cache

# ============================================================================
# Performance Configuration
# ============================================================================

# Batch processing size
BATCH_SIZE=10

# Number of worker processes
WORKERS=4

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# LLM request timeout (seconds)
LLM_TIMEOUT=60

# ============================================================================
# API Configuration (for web service)
# ============================================================================

# API host
API_HOST=0.0.0.0

# API port
API_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=*

# ============================================================================
# Document Processing
# ============================================================================

# Supported document types
SUPPORTED_FORMATS=.txt,.pdf,.png,.jpg,.jpeg,.tiff,.bmp

# ============================================================================
# Notification Configuration (Optional)
# ============================================================================

# Slack webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email for alerts
ALERT_EMAIL=admin@company.com

# ============================================================================
# Development/Debug
# ============================================================================

# Debug mode
DEBUG=false

# Enable detailed logging
VERBOSE=false

# Test mode (uses mock data)
TEST_MODE=false
